tools/scroll_event_capture
tools/scroll_momentum_probe
tools/gpu_stress_probe
tools/gpu_bandwidth_stress_probe
tools/ram_pressure_probe

# Xcode user-specific settings (editor state, breakpoints, etc.)
xcuserdata/
*.xcuserstate
*.xccheckout

# Swift Package Manager
.build/
.swiftpm/

# Python bytecode cache
__pycache__/

# Playgrounds
timeline.xctimeline
playground.xcworkspace

Notes/Scratch/
