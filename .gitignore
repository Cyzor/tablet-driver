# macOS
.DS_Store
.AppleDouble
.LSOverride

# Xcode build output
build/
DerivedData/
*.xcarchive

# Release artifacts (DMGs and staging; uploaded to GitHub Releases, not committed)
dist/

# Compiled capture tools (each header has its build line). Sources all
# have an extension; the binaries built beside them don't.
tools/capture/*
!tools/capture/*.*

# Xcode user-specific settings (editor state, breakpoints, etc.)
xcuserdata/
*.xcuserstate
*.xccheckout

# Swift Package Manager
.build/
.swiftpm/
# Xcode rewrites and deletes this on its own (a `swift test` inside TabletKit
# removes it), and TabletKit is a local package reference with no remote
# versions to pin, so tracking it only produced a permanently dirty tree.
MockTab.xcodeproj/project.xcworkspace/xcshareddata/swiftpm/Package.resolved

# Python bytecode cache
__pycache__/

# Playgrounds
timeline.xctimeline
playground.xcworkspace

Notes/Scratch/
Design/scratch-reference.ai
