# macOS
.DS_Store
.AppleDouble
.LSOverride

# Xcode build output
build/
DerivedData/
*.xcarchive

# Release artifacts (DMGs and staging; uploaded to GitHub Releases, not committed)
dist/

# Generated tool output (regenerate with tools/audit_registry.py)
tools/registry_audit.csv

# Compiled diagnostic tools (build with the compile line in each header comment)
tools/scroll_event_capture
tools/scroll_momentum_probe
tools/gpu_stress_probe
tools/gpu_bandwidth_stress_probe
tools/ram_pressure_probe
tools/pages-click-probe/pages-click-probe

# Xcode user-specific settings (editor state, breakpoints, etc.)
xcuserdata/
*.xcuserstate
*.xccheckout

# Swift Package Manager
.build/
.swiftpm/
# Xcode rewrites and deletes this on its own (a `swift test` inside TabletKit
# removes it), and TabletKit is a local package reference with no remote
# versions to pin, so tracking it only produced a permanently dirty tree.
MockTab.xcodeproj/project.xcworkspace/xcshareddata/swiftpm/Package.resolved

# Python bytecode cache
__pycache__/

# Playgrounds
timeline.xctimeline
playground.xcworkspace

Notes/Scratch/
Design/scratch-reference.ai
