    "Assign a click, modifier key, display switch, or other action instead of a shortcut." : {
      "comment" : "Tooltip on the click action menu beside the shortcut recorder",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Statt eines Kurzbefehls einen Klick, eine Modifikatortaste, einen Displaywechsel oder eine andere Aktion zuweisen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Asigna un clic, una tecla modificadora, un cambio de pantalla u otra acción en lugar de un atajo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Attribuez un clic, une touche de modification, un changement d’écran ou une autre action au lieu d’un raccourci."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
