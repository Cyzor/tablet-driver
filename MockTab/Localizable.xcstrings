    "Rotate the active surface 90° clockwise. Hold the tablet in portrait orientation." : {
      "comment" : "Tablet orientation help text",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dreh die aktive Fläche um 90° im Uhrzeigersinn. Halte das Grafiktablett im Hochformat."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Rotate the active surface 90° clockwise. Hold the tablet in portrait orientation."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gira la superficie activa 90° en sentido horario. Sostén la tableta en orientación vertical."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fait pivoter la surface active de 90° en sens horaire. Tenez la tablette en orientation portrait."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ruota la superficie attiva di 90° in senso orario. Tieni la tavoletta in verticale."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アクティブ面を時計回りに90°回転させます。タブレットを縦向きに持ちます。"
          }
        }
      }
    },
    "Rotate the active surface 90° counter-clockwise." : {
      "comment" : "Tablet orientation help text",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dreh die aktive Fläche um 90° gegen den Uhrzeigersinn."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Rotate the active surface 90° counter-clockwise."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gira la superficie activa 90° en sentido antihorario."
          }
        },
        "fr" : {
