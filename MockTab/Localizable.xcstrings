    "(renamed to avoid conflict)": {
      "comment": "A note appended to a renamed profile name to indicate that it was renamed to avoid a conflict with an existing profile.",
      "isCommentAutoGenerated": true
    },
    "%@ connected": {
      "comment": "The text and icon displayed in the menu bar for the status of the connected tablet.",
