    },
    "Allow MockTab to move the pointer and press keys. Without this, the pen is read but moves nothing." : {
      "comment" : "Tooltip on Grant button for Accessibility permission",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MockTab erlauben, den Zeiger zu bewegen und Tasten zu drücken. Ohne diese Berechtigung wird der Stift gelesen, bewegt aber nichts."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permitir que MockTab mueva el puntero y pulse teclas. Sin esto, el lápiz se lee pero no mueve nada."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Autorisez MockTab à déplacer le pointeur et à appuyer sur des touches. Sans cela, le stylet est lu mais ne déplace rien."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Consenti a MockTab di muovere il puntatore e premere tasti. Senza questo, la penna viene letta ma non muove nulla."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MockTabがポインタを移動しキーを押せるようにします。これがないと、ペンは読み取られても何も動かしません。"
          }
        }
      }
    },
    "Allow MockTab to read your tablet. Without this, MockTab sees the tablet but none of its input." : {
      "comment" : "Tooltip on Grant button for Input Monitoring permission",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MockTab erlauben, dein Grafiktablett zu lesen. Ohne diese Berechtigung sieht MockTab das Grafiktablett, aber keine Eingaben."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permitir que MockTab lea la tableta. Sin esto, MockTab ve la tableta pero no recibe nada de ella."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Autorisez MockTab à lire votre tablette. Sans cela, MockTab voit la tablette mais rien de ce qu’elle envoie."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Consenti a MockTab di leggere la tavoletta. Senza questo, MockTab vede la tavoletta ma nessun suo input."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MockTabがタブレットを読み取れるようにします。これがないと、MockTabはタブレットを認識しても入力を受け取れません。"
          }
        }
      }
    },
