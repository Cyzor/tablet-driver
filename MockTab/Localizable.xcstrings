    "Linear response — equal pen force produces equal pressure output. Best for general use." : {
      "comment" : "A tooltip explaining the \"Linear\" pressure curve setting.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lineare Reaktion — gleiche Stiftkraft erzeugt gleiche Druckausgabe. Am besten für die allgemeine Verwendung."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Respuesta lineal — igual fuerza del bolígrafo produce igual salida de presión. Mejor para uso general."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "リニア応答 — ペン力が等しいと圧力出力も等しい。一般的な使用に最適。"
          }
        }
      }
    },
