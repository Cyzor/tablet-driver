    "Two fingers moving together post smooth scroll events that apps treat as trackpad scrolling, including rubber-banding in Safari and Preview." : {
      "comment" : "Help text for the \"Two-finger scroll\" toggle in the TouchView.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zwei sich gemeinsam bewegende Finger senden weiche Scrollereignisse, die Apps als Trackpad-Scrollen behandeln, einschließlich Rubber-Banding in Safari und Vorschau."
          }
        },
        "es" : {
