    "How close a second tap must land to the first to count as a double-click. Drag to Off to disable position snapping." : {
      "comment" : "A description of the slider that determines how close a second tap must be to the first to be counted as a double-click.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wie nah ein zweiter Tipp am ersten liegen muss, um als Doppelklick zu gelten. Auf „Aus\" ziehen, um die Positionskorrektur zu deaktivieren."
          }
        },
        "en" : {
          "stringUnit" : {
