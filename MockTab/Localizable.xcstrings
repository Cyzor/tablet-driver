{
  "sourceLanguage": "en",
  "strings": {
    "": {},
    " — %@": {
      "comment": "A subtitle below the \"Tools\" header, showing which tablet's tools are currently displayed. The argument is the nickname of the currently selected tablet.",
      "isCommentAutoGenerated": true
    },
    " Absolute, like a stylus": {
      "comment": "Movement mode label after SF Symbol",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": " Absolut, wie ein Stift"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": " Absoluto, como un lápiz"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": " 絶対、スタイラスのように"
          }
        }
      }
    },
    " Clockwise": {
      "comment": "Rotation direction label after SF Symbol",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": " Im Uhrzeigersinn"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": " En sentido horario"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": " 時計回り"
          }
        }
      }
    },
    " Counter-clockwise": {
      "comment": "Rotation direction label after SF Symbol",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": " Gegen den Uhrzeigersinn"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": " En sentido antihorario"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": " 反時計回り"
          }
        }
      }
    },
    " Relative, like a mouse": {
      "comment": "Movement mode label after SF Symbol",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": " Relativ, wie eine Maus"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": " Relativo, como un ratón"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": " 相対、マウスのように"
          }
        }
      }
    },
    "—": {},
    "· changes apply only when %@ is active": {
      "comment": "A note below the app name in the override bar, explaining that changes apply only when the app is active.",
      "isCommentAutoGenerated": true
    },
    "\"%@\"": {
      "comment": "A text label displaying the name of a newly-created medication profile. The text inside the quotation marks should be replaced with the actual name of the profile.",
      "isCommentAutoGenerated": true
    },
    "“Once,” said the Mock Turtle at last, with a deep sigh, “I was a real Turtle.”": {
      "comment": "A quote attributed to a Mock Turtle, used in the \"About\" view.",
      "isCommentAutoGenerated": true
    },
    "(%@)": {
      "comment": "A label showing the build number of the app. The argument is the build number. The argument is the string “?.?”.",
      "isCommentAutoGenerated": true
    },
    "(Auto-detect)": {
      "comment": "A placeholder text for an option in the tool override picker. It indicates that the tool code is automatically detected.",
      "isCommentAutoGenerated": true,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "(Automatisch erkennen)"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "(Detección automática)"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "(自動検出)"
          }
        }
      }
    },
    "(Auto: %@)": {
      "comment": "Auto-activation suffix in Profile row, e.g. '(Auto: TextEdit)'",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "(Auto: %@)"
