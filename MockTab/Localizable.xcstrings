          }
        }
      }
    },
    "MockTab is using its generic driver for this device. Basic pen input may work, but full support requires a short data-collection session." : {
      "comment" : "Body of the unknown-device banner",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MockTab verwendet seinen generischen Treiber für dieses Gerät. Grundlegende Stifteingabe könnte funktionieren, aber volle Unterstützung erfordert eine kurze Datenerfassungssitzung."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MockTab está usando su controlador genérico para este dispositivo. La entrada básica con lápiz puede funcionar, pero la compatibilidad completa requiere una breve sesión de recopilación de datos."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MockTabはこのデバイスに汎用ドライバーを使用しています。基本的なペ入力は動作する可能性がありますが、完全なサポートには短いデータ収集セッションが必要です。"
          }
        }
      }
    },
    "MockTab Website…" : {
      "comment" : "Help menu: open MockTab website",
      "localizations" : {
