    "⌘+click to add or remove a display from the selection. ⇧+click to select a range." : {
      "comment" : "Help text for the display canvas while in Toggle or Span mode",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "⌘+Klick fügt ein Display zur Auswahl hinzu oder entfernt es. ⇧+Klick wählt einen Bereich aus."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "⌘+clic añade o quita una pantalla de la selección. ⇧+clic selecciona un rango."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "⌘+clic pour ajouter ou retirer un écran de la sélection. ⇧+clic pour sélectionner une plage."
          }
