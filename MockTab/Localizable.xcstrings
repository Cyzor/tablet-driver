    "OLED Brightness" : {
      "comment" : "Quick Keys OLED brightness row label",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OLED-Helligkeit"
          }
        },
        "es" : {
          "stringUnit" : {
