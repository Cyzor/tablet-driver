          "stringUnit" : {
            "state" : "translated",
            "value" : "Usa un botón para cambiar el mapeo activo de la tableta entre las pantallas seleccionadas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
