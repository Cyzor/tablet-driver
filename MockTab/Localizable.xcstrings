    "Shows most in slow, light strokes. Firm pressure passes through unchanged." : {
      "comment" : "Tooltip on the Pressure Smoothing strength slider",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wirkt vor allem bei langsamen, leichten Strichen. Fester Druck bleibt unverändert."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se nota sobre todo en trazos lentos y suaves. La presión firme pasa sin cambios."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Surtout visible sur les tracés lents et légers. Les pressions fortes restent inchangées."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si nota soprattutto nei tratti lenti e leggeri. Le pressioni forti restano invariate."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ゆっくりとした軽いストロークで最も効果があります。強い筆圧はそのまま通ります。"
          }
        }
      }
    },
