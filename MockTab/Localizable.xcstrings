    "A brief touch with no significant motion posts a left mouse click. Off by default, because most people find it causes phantom clicks." : {
      "comment" : "Tooltip on the Tap to Click switch",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine kurze Berührung ohne nennenswerte Bewegung sendet einen Linksklick. Standardmäßig aus, weil es bei den meisten zu Geisterklicks führt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un toque breve sin apenas movimiento envía un clic izquierdo. Desactivado por defecto, porque a la mayoría le provoca clics fantasma."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un bref toucher sans déplacement notable produit un clic gauche. Désactivé par défaut, car il provoque des clics involontaires chez la plupart des utilisateurs."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un breve tocco quasi senza movimento produce un clic sinistro. Disattivato di default, perché per molti causa clic involontari."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "大きな動きを伴わない短い接触で左クリックを送信します。意図しないクリックが起きやすいため、既定ではオフです。"
          }
        }
      }
    },
    "A pre-release version is also available. Hold Option to check for it." : {
      "comment" : "Updates section subtitle when the release is current and a newer test build exists; Option turns Check Now into Check for Pre-release",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine Vorabversion ist ebenfalls verfügbar. Zum Suchen die Option-Taste gedrückt halten."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "También hay una versión preliminar. Mantén pulsada la tecla Opción para buscarla."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une préversion est aussi disponible. Maintenez la touche Option pour la rechercher."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "È disponibile anche una versione preliminare. Tieni premuto Opzione per cercarla."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "プレリリース版もあります。Option キーを押したまま確認できます。"
          }
        }
      }
    },
    "A pre-release version. You have %@." : {
      "comment" : "Updates section subtitle under an available pre-release",
      "localizations" : {
        "de" : {
          "stringUnit" : {
