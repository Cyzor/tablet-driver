    "Add per-app override — or drag an app here from Finder or the Dock": {
      "comment": "A help string explaining how to add an app override using the app overide bar.",
      "isCommentAutoGenerated": true,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "App-spezifische Einstellung hinzufügen — oder App hierher aus Finder oder Dock ziehen"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Agregar anulación específica de la aplicación — o arrastrar una aplicación aquí desde Finder o el Dock"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アプリ固有のオーバーライドを追加 — または Finder/Dock からアプリをドラッグ"
          }
        }
      }
    },
    "alert.conflicts.intro": {
      "comment": "First sentence of conflict alert body",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "MockTab hat folgende Probleme gefunden, die den Tablettbetrieb beeinträchtigen könnten:"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "MockTab found the following issues that may interfere with tablet operation:"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "MockTab ha encontrado los siguientes problemas que pueden interferir con el funcionamiento de la tableta:"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "MockTabはタブレットの操作に干渉する可能性のある以下の問題を検出しました："
          }
        }
      }
    },
    "alert.conflicts.recommendation": {
      "comment": "Recommendation paragraph at the end of the conflict alert body",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Empfehlung: Beenden oder deaktivieren Sie die aufgelisteten Prozesse und starten Sie MockTab neu. Bei Wacom-Treibern prüfen Sie unter Systemeinstellungen → Allgemein → Startobjekte, ob diese beim Start geöffnet werden. Bei HF-Rauschen versuchen Sie, Empfänger (Mäuse, Tastaturen, WLAN-Dongles) vom Tablett zu entfernen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Recommendation: Quit or disable the listed processes, then restart MockTab. For Wacom drivers, check System Settings → General → Login Items to prevent them from launching at startup. For RF jitter, try moving wireless receivers (mice, keyboards, Wi-Fi dongles) away from the tablet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Recomendación: Cierre o desactive los procesos indicados y reinicie MockTab. Para controladores Wacom, compruebe en Configuración del sistema → General → Elementos de inicio de sesión que no se inicien al arrancar. Si hay interferencia de RF, intente alejar los receptores inalámbricos de la tableta."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "推奨事項：リストされたプロセスを終了または無効にして、MockTabを再起動してください。Wacomドライバーの場合は、システム設定 → 一般 → ログイン項目 で起動時に開かないように確認してください。RFの干渉の場合は、ワイヤレス受信機をタブレットから遠ざけてみてください。"
          }
        }
      }
    },
    "alert.conflicts.title": {
      "comment": "Alert title when user taps Fix on the Conflicts row",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
