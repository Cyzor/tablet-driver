    "A brief touch with no significant motion posts a left mouse click. Off by default — most users find it produces phantom clicks." : {
      "comment" : "Help text for the \"Tap to click\" toggle in the TouchView.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine kurze Berührung ohne nennenswerte Bewegung sendet einen Linksklick. Standardmäßig deaktiviert — die meisten Nutzer finden, dass dies Geisterklicks erzeugt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un toque breve sin movimiento significativo emite un clic izquierdo. Desactivado por defecto — la mayoría de los usuarios descubre que produce clics fantasma."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "大きな動きを伴わない短い接触で左クリックを送信します。既定でオフです。指をタブレットに置いたままだと意図しないクリックが発生する傾向があります。"
          }
        }
      }
    },
