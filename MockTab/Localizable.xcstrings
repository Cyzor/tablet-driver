    "Click to record a keyboard shortcut. Press Escape to cancel or Delete to clear. Use the ▾ menu to assign a click action." : {
      "comment" : "A help string explaining how to use the button binding control.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Klick, um einen Tastaturkurzbefehl aufzunehmen. Escape zum Abbrechen, Entf zum Löschen. Über das ▾-Menü kannst du auch eine Klickaktion zuweisen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Click to record a keyboard shortcut. Press Escape to cancel or Delete to clear. Use the ▾ menu to assign a click action."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Haz clic para grabar un atajo de teclado. Pulsa Escape para cancelar o Supr para borrar. Usa el menú ▾ para asignar una acción de clic."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "キーボードショートカットを記録するにはクリックします。Esc キーでキャンセル、Delete キーで削除できます。▾ メニューからクリック操作を割り当ててください。"
          }
        }
      }
    },
