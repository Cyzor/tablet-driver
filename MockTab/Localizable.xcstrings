    "Reduces cursor jitter. Higher values add lag.": {
      "comment": "Help text under stabilization slider",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Reduziert das Zittern des Cursors. Höhere Werte erhöhen die Latenz."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Reduce el temblor del cursor. Los valores más altos añaden latencia."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "カーソルのブレを減らします。値が高いほどラグが増えます。"
          }
        }
      }
    },
