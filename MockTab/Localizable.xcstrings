          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cambia los ajustes de la propia pantalla por el cable de vídeo. Esta pantalla no informa de sus ajustes, así que los controles empiezan donde los dejaste."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Modifie les réglages propres à l’écran via son câble vidéo. Cet écran n’indique pas ses réglages : les curseurs partent donc de vos dernières valeurs."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
