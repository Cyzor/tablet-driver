    "Click a display to map the tablet to it. ⌘+click to add it to the toggle rotation. ⇧+click to span all displays." : {
      "comment" : "Help: display canvas interaction",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Klick auf ein Display, um das Grafiktablett darauf zu mappen. ⌘+Klick fügt es zur Umschalt-Rotation hinzu. ⇧+Klick spannt alle Displays auf."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Click a display to map the tablet to it. ⌘+click to add it to the toggle rotation. ⇧+click to span all displays."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Haz clic en una pantalla para asignar la tableta. ⌘+clic para añadirla a la rotación de alternancia. ⇧+clic para abarcar todas las pantallas."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ディスプレイをクリックしてタブレットをそこにマップします。⌘+クリックでローテーション切り替えに追加; ⇧+クリックですべてのディスプレイをスパン。"
          }
        }
      }
    },
    "Click a thumbnail to toggle that display in or out of the rotation. ⌘-click to add individual displays; ⇧-click to select a range." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Thumbnail anklicken, um ein Display in die Rotation aufzunehmen oder zu entfernen. ⌘-Klick für einzelne Displays; ⇧-Klick für einen Bereich."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Haz clic en una miniatura para incluir o excluir esa pantalla de la rotación. ⌘-clic para pantallas individuales; ⇧-clic para un rango."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "サムネイルをクリックして、そのディスプレイをローテーションに含めるか外すかを切り替えます。⌘クリックで個別追加、⇧クリックで範囲選択。"
          }
        }
      }
    },
