      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Speichere deine Einstellungen als JSON-Datei. Dann kannst du sie später wiederherstellen, falls sie zurückgesetzt oder verloren gehen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Save your settings as a JSON file. You can reload them later if they ever get reset or damaged."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Guarda tus ajustes como un archivo JSON. Así podrás recuperarlos después si se borran o se estropean."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "設定をJSONファイルとして保存してください。後でリセットされたり壊れたりした場合に復元できます。"
