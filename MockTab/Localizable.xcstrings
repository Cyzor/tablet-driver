    "“Once,” said the Mock Turtle at last, with a deep sigh, “I was a real Turtle.”" : {
      "comment" : "A quote attributed to a Mock Turtle, used in the \"About\" view.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "»Einst,« sagte die falsche Schildkröte endlich mit einem tiefen Seufzer, »war ich eine wirkliche Schildkröte.«"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "“Once,” said the Mock Turtle at last, with a deep sigh, “I was a real Turtle.”"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "-Hubo un tiempo -dijo por fin la Falsa Tortuga, con un profundo suspiro- en que yo era una tortuga de verdad."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「むかしは、ぼくもほんもののウミガメでしたのさ」にせウミガメはやっと口をひらきました。"
          }
        }
      }
    },
