      }
    },
    "The connected tablet does not have a capacitive touch surface." : {
      "comment" : "Text displayed in a form section when a tablet without a capacitive touch surface is connected.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das angeschlossene Tablet hat keine kapazitive Berührungsfläche."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La tableta conectada no tiene superficie táctil capacitiva."
          }
        },
