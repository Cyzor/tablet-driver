    },
    "Flips the direction of the dial, whatever its mode is set to. Turn on if the dial runs opposite to your expectation." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kehrt die Richtung des Einstellrads um, unabhängig vom eingestellten Modus. Aktiviere dies, wenn das Einstellrad entgegen deiner Erwartung läuft."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Invierte la dirección del dial, sea cual sea su modo. Actívalo si el dial funciona al contrario de lo que esperas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inverse le sens de la molette, quel que soit son mode. Activez-le si la molette tourne à l’inverse de ce que vous attendez."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inverte la direzione della ghiera, qualunque sia la modalità. Attivalo se la ghiera gira al contrario di come ti aspetti."
          }
