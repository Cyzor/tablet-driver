    "Click a display to map the tablet to it. ⌘+click to add it to the toggle rotation. ⇧+click to span all displays." : {
      "comment" : "Help text for the display canvas in single-display modes",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Klick auf ein Display, um das Grafiktablett darauf zu mappen. ⌘+Klick fügt es zur Umschalt-Rotation hinzu. ⇧+Klick spannt alle Displays auf."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Click a display to map the tablet to it. ⌘+click to add it to the toggle rotation. ⇧+click to span all displays."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Haz clic en una pantalla para asignar la tableta. ⌘+clic para añadirla a la rotación de alternancia. ⇧+clic para abarcar todas las pantallas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cliquez sur un écran pour y associer la tablette. ⌘+clic pour l’ajouter aux écrans à parcourir. ⇧+clic pour étendre sur tous les écrans."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fai clic su un monitor per associarlo alla tavoletta. ⌘+clic per aggiungerlo ai monitor tra cui alternare. ⇧+clic per estendere su tutti i monitor."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ディスプレイをクリックしてタブレットをそこにマップします。⌘+クリックでローテーション切り替えに追加; ⇧+クリックですべてのディスプレイをスパン。"
          }
        }
      }
    },
    "Click a display to map the tablet to it. Command-click to add it to the toggle rotation. Shift-click to span all displays." : {
      "comment" : "VoiceOver hint for the display canvas in single-display modes",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Klick auf ein Display, um das Grafiktablett darauf zu mappen. Command-Klick fügt es zur Umschalt-Rotation hinzu. Shift-Klick spannt alle Displays auf."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Haz clic en una pantalla para asignarle la tableta. Comando-clic la añade a la rotación de alternancia. Mayúsculas-clic abarca todas las pantallas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cliquez sur un écran pour y associer la tablette. Commande-clic pour l’ajouter aux écrans à parcourir. Maj-clic pour étendre sur tous les écrans."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fai clic su un monitor per associarlo alla tavoletta. Comando-clic per aggiungerlo ai monitor tra cui alternare. Maiuscole-clic per estendere su tutti i monitor."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ディスプレイをクリックすると、タブレットをそのディスプレイにマップします。Command キーを押しながらクリックするとローテーション切り替えに追加し、Shift キーを押しながらクリックするとすべてのディスプレイにまたがります。"
          }
        }
      }
    },
    "Click a thumbnail to toggle that display in or out of the rotation. ⌘-click to add individual displays; ⇧-click to select a range." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Thumbnail anklicken, um ein Display in die Rotation aufzunehmen oder zu entfernen. ⌘-Klick für einzelne Displays; ⇧-Klick für einen Bereich."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Haz clic en una miniatura para incluir o excluir esa pantalla de la rotación. ⌘-clic para pantallas individuales; ⇧-clic para un rango."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cliquez sur une vignette pour ajouter ou retirer cet écran de la sélection. ⌘-clic pour ajouter des écrans un à un ; ⇧-clic pour sélectionner une plage."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fai clic su una miniatura per aggiungere o rimuovere quel monitor dalla selezione. ⌘-clic per aggiungere singoli monitor; ⇧-clic per selezionare un intervallo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "サムネイルをクリックして、そのディスプレイをローテーションに含めるか外すかを切り替えます。⌘クリックで個別追加、⇧クリックで範囲選択。"
          }
        }
      }
    },
