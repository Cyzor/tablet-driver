    "Use a button press to cycle the tablet's active mapping between selected displays." : {
      "comment" : "A hint explaining how to cycle between different tablet mappings.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Über einen Tastendruck die aktive Grafiktablett-Zuordnung zwischen ausgewählten Displays wechseln."
          }
        },
