    "MockTab couldn't write to your Desktop. Choose where to save the collected device data." : {
      "comment" : "Explanation in the capture save panel after a Desktop write failure",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "MockTab konnte nicht auf den Schreibtisch schreiben. Wähle aus, wo die erfassten Gerätedaten gespeichert werden sollen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "MockTab no pudo escribir en tu Escritorio. Elige dónde guardar los datos del dispositivo recopilados."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
