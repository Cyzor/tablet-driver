      "isCommentAutoGenerated" : true,
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Weiche Reaktion — leichter Druck erreicht schnell maximale Ausgabe. Gut für lockere, ausdrucksstarke Arbeiten."
