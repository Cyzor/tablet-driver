    "Prevents a light tap from turning into an accidental drag due to hand tremor or pressure jitter right when the tip touches down. Drag to Off to disable." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verhindert, dass ein leichter Tipp durch Handzittern oder Druckschwankungen beim Aufsetzen versehentlich zu einem Ziehen wird. Zum Deaktivieren auf Aus ziehen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Evita que un toque suave se convierta en un arrastre accidental por temblor de la mano o fluctuaciones de presión justo al apoyar la punta. Arrastra a Desactivado para desactivarlo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ペン先を下ろした瞬間の手ぶれや筆圧の揺れによって、軽いタップが誤ってドラッグになるのを防ぎます。無効にするには「オフ」までドラッグしてください。"
          }
        }
      }
    },
    "Prevents accidental stroke movement when lifting pen." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verhindert versehentliche Strichbewegungen beim Abheben des Stifts."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Evita movimientos de trazo accidentales al levantar el lápiz."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ペンを離すときの意図しないストローク移動を防ぎます。"
          }
        }
      }
    },
