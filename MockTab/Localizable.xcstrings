    "Helps add support for your device by capturing its HID report layout." : {
      "comment" : "Subtitle for device data collection when tablet is not yet supported",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hilft dabei, Unterstützung für dein Gerät hinzuzufügen, indem das HID-Berichtslayout erfasst wird."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Helps add support for your device by capturing its HID report layout."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ayuda a agregar soporte para su dispositivo al capturar su diseño de informe HID."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "HID レポートレイアウトをキャプチャすることで、デバイスのサポート追加を支援します。"
          }
        }
      }
    },
    "HID latency    : %@ ms avg, %@ ms worst, %llu stalls >%lld ms" : {
      "comment" : "Diagnostic: HID report delivery latency from kernel receipt to driver callback",
      "localizations" : {
        "en" : {
