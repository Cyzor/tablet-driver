    "Turn Assignments Around" : {
      "comment" : "Tablet diagram right-click command and its undo name: moves each key's assignment to the key in the opposite place, as a half turn would, without turning the tablet",
      "localizations" : {
        "de" : {
          "stringUnit" : {
