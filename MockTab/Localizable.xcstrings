    "Move wireless receivers (mice, keyboards, Wi-Fi dongles) away from the tablet." : {
      "comment" : "Remedy line for an RF-interference finding in the conflict alert",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wireless-Empfänger (Maus, Tastatur, Wi-Fi-Dongles) vom Tablett entfernen."
          }
        },
        "es" : {
          "stringUnit" : {
