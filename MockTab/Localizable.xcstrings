    "Guides you through a short set of actions to capture how your device communicates. Produces a small JSON file you can share to add or fix device support." : {
      "comment" : "Help text for the Collect Device Data button",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Führt dich durch einige Aktionen, um die Kommunikation deines Geräts zu erfassen. Erzeugt eine kleine JSON-Datei, die du teilen kannst, um die Geräteunterstützung zu ergänzen oder zu verbessern."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Guides you through a short set of actions to capture how your device communicates. Produces a small JSON file you can share to add or fix device support."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le guía a través de un breve conjunto de acciones para capturar cómo se comunica su dispositivo. Produce un pequeño archivo JSON que puede compartir para agregar o corregir la compatibilidad del dispositivo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "デバイスの通信方法をキャプチャするための一連の操作を案内します。デバイスのサポートを追加または修正するために共有できる小さな JSON ファイルを生成します。"
          }
        }
      }
    },
    "Height" : {
      "comment" : "Coordinate readout label in Tablet Area tab",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
