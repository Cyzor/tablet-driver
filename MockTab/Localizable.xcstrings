    },
    "Make the active area the screen area's shape, as large as the tablet allows, so drawing keeps its shape." : {
      "comment" : "Tooltip for the Fit to Screen Area button",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gibt dem aktiven Bereich die Form des Bildschirmbereichs, so groß wie möglich, damit Zeichnungen ihre Form behalten."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Da al área activa la forma del área de pantalla, lo más grande posible, para que el dibujo conserve su forma."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Donne à la zone active la forme de la zone d’écran, aussi grande que la tablette le permet, pour que le dessin garde ses proportions."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dà all’area attiva la forma dell’area dello schermo, grande quanto la tavoletta consente, così il disegno mantiene le proporzioni."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アクティブ領域を画面エリアと同じ形にし、できるだけ大きくします。描いた形が歪みません。"
          }
        }
      }
    },
    "Make the screen area the tablet's shape, as large as the display allows, so none of the tablet goes unused." : {
      "comment" : "Tooltip for the Fit to Tablet button",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gibt dem Bildschirmbereich die Form des Grafiktabletts, so groß wie möglich – so bleibt keine Tablettfläche ungenutzt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Da al área de pantalla la forma de la tableta, lo más grande posible, para no desperdiciar superficie de la tableta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Donne à la zone d’écran la forme de la tablette, aussi grande que l’écran le permet, pour que toute la tablette serve."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dà all’area dello schermo la forma della tavoletta, grande quanto il monitor consente, così nessuna parte della tavoletta resta inutilizzata."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "画面エリアをタブレットと同じ形にし、できるだけ大きくします。タブレットの面積を無駄にしません。"
          }
        }
      }
    },
    "Map the pen to its own display, or include that display in Toggle, to calibrate." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zum Kalibrieren den Stift seinem eigenen Display zuordnen oder das Display in „Zwischen Displays wechseln“ aufnehmen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para calibrar, asigna el lápiz a su propia pantalla o incluye esa pantalla en «Alternar entre pantallas»."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pour calibrer, associez le stylet à son propre écran ou incluez cet écran dans la bascule."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Per calibrare, mappa la penna sul suo monitor o includi quel monitor tra quelli da alternare."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "キャリブレーションするには、ペンを専用のディスプレイに割り当てるか、そのディスプレイを「ディスプレイ間を切り替え」に含めてください。"
          }
        }
      }
    },
    "Map the tablet across all displays as one continuous surface." : {
      "comment" : "A radio button label that allows mapping the tablet across all displays.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Grafiktablett über alle Displays als eine durchgehende Oberfläche abbilden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Map the tablet across all displays as one continuous surface."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Asignar la tableta en todas las pantallas como una sola superficie continua."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Associe la tablette à tous les écrans comme une seule surface continue."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mappa la tavoletta su tutti i monitor come un’unica superficie continua."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "タブレットをすべてのディスプレイ全体に1つの連続した表面としてマップ。"
          }
        }
      }
    },
    "Map the tablet across only the selected displays as one continuous surface." : {
      "comment" : "A radio button label that allows mapping the tablet across only the selected displays.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Grafiktablett über die ausgewählten Displays als eine durchgehende Oberfläche abbilden."
          }
