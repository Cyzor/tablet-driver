    " Absolute, like a stylus." : {
      "comment" : "Movement mode label appended after an SF Symbol glyph — keep the leading space",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : " Absolut, wie ein Stift."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : " Absoluto, como un lápiz."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : " Absolu, comme un stylet."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : " Assoluto, come una penna."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : " 絶対、スタイラスのように。"
          }
        }
