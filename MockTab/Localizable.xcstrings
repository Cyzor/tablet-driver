    "Absorbs tremor and pressure jitter as the tip touches down. Drag to Off to disable." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fängt Handzittern und Druckschwankungen beim Aufsetzen der Spitze ab. Zum Deaktivieren auf Aus ziehen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Absorbe el temblor y las fluctuaciones de presión al apoyar la punta. Arrastra a Desactivado para desactivarlo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Absorbe les tremblements et les variations de pression quand la pointe se pose. Faites glisser sur Désactivé pour le désactiver."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Assorbe tremiti e sbalzi di pressione quando la punta si appoggia. Trascina su Disattivato per disattivarlo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ペン先を下ろした瞬間の手ぶれや筆圧の揺れを吸収します。無効にするには「オフ」までドラッグしてください。"
          }
        }
      }
    },
