    "Reduces cursor jitter. Higher values add lag.": {
      "comment": "Help text under stabilization slider",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Reduziert das Zittern des Cursors. Höhere Werte erhöhen die Latenz."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Reduce el temblor del cursor. Los valores más altos añaden latencia."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "カーソルのブレを減らします。値が高いほどラグが増えます。"
          }
        }
      }
    },
    "Reduces cursor wobble from hand tremor. Higher values smooth more aggressively but add input lag.": {
      "comment": "Help: smoothing strength",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Reduziert das Zittern des Cursors durch Handzittern. Höhere Werte glätten aggressiver, erhöhen aber die Eingabeverzögerung."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Reduce el temblor del cursor por temblor manual. Valores más altos suavizan más agresivamente pero añaden latencia de entrada."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "手の震えによるカーソル揺らぎを低減。値が高いほどより積極的に滑らかにしますが、入力遅延が増加します。"
          }
        }
      }
    },
