    "Wireless interference also affects the pen. Move mouse, keyboard, and Wi-Fi receivers away from the tablet." : {
      "comment" : "Conflict alert paragraph for wireless interference, after the text about other drivers",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Auch eine Funkstörung beeinträchtigt den Stift. Halte Empfänger von Maus, Tastatur und WLAN vom Grafiktablett fern."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las interferencias inalámbricas también afectan al lápiz. Aleje de la tableta los receptores de ratón, teclado y Wi-Fi."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les interférences sans fil affectent aussi le stylet. Éloignez de la tablette les récepteurs de souris, de clavier et Wi-Fi."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le interferenze wireless influiscono anche sulla penna. Allontana dalla tavoletta i ricevitori di mouse, tastiera e Wi-Fi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "無線干渉もペンに影響しています。マウス、キーボード、Wi-Fi の受信機をタブレットから離してください。"
          }
        }
      }
    },
    "Wireless Kit" : {
      "comment" : "Connection value for a tablet on the Wacom wireless kit",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wireless-Kit"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kit inalámbrico"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kit sans fil"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kit wireless"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ワイヤレスキット"
          }
        }
      }
    },
    "Works only through the wireless receiver." : {
      "comment" : "Tooltip on the wireless kit sleep timer while the tablet is on USB",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Funktioniert nur über den Wireless-Empfänger."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solo funciona con el receptor inalámbrico."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fonctionne uniquement via le récepteur sans fil."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Funziona solo tramite il ricevitore wireless."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ワイヤレスレシーバー経由でのみ使えます。"
          }
        }
      }
    },
    "Works wherever a trackpad pinch does, such as Safari, Preview, and Photoshop." : {
      "comment" : "Tooltip on the Pinch to Zoom switch",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Funktioniert überall, wo das Zoomen per Trackpad funktioniert, etwa in Safari, Vorschau und Photoshop."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Funciona donde funcione el pellizco del trackpad, como Safari, Vista Previa y Photoshop."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fonctionne partout où le pincement du trackpad fonctionne, comme Safari, Aperçu et Photoshop."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Funziona ovunque funzioni il pizzico del trackpad, come Safari, Anteprima e Photoshop."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Safari、プレビュー、Photoshop など、トラックパッドのピンチが使える場所ならどこでも動作します。"
          }
        }
      }
    },
    "Works wherever a trackpad rotate does." : {
      "comment" : "Tooltip on the Rotate switch",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Funktioniert überall, wo die Drehgeste des Trackpads funktioniert."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Funciona donde funcione el gesto de girar del trackpad."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fonctionne partout où la rotation du trackpad fonctionne."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Funziona ovunque funzioni la rotazione del trackpad."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "トラックパッドの回転ジェスチャーが使える場所ならどこでも動作します。"
          }
        }
      }
    },
    "Works with pens that rotate, such as the Art Pen. Available once one is used on this tablet." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Für Stifte, die sich drehen lassen, etwa den Art Pen. Verfügbar, sobald einer an diesem Tablet benutzt wurde."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Funciona con lápices que giran, como el Art Pen. Disponible en cuanto se use uno en esta tableta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fonctionne avec les stylets qui tournent sur leur axe, comme l’Art Pen. Disponible dès qu’un tel stylet a servi sur cette tablette."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Funziona con le penne che ruotano sul proprio asse, come la Art Pen. Disponibile dopo averne usata una su questa tavoletta."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Art Pen など、回転を検出できるペンで使えます。このタブレットで一度使うと利用できるようになります。"
          }
        }
      }
    },
