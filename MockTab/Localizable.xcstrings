          }
        }
      }
    },
    "Movement" : {
      "comment" : "Section header in Pen Feel tab",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bewegung"
          }
        },
        "en" : {
