    "Linear response. Equal pen force produces equal pressure output. Best for general use." : {
      "comment" : "Tooltip on the Linear pressure curve button",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lineare Reaktion. Gleiche Stiftkraft ergibt gleiche Druckausgabe. Am besten für den Alltag."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Respuesta lineal. La misma fuerza del lápiz da la misma presión. Lo mejor para uso general."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Réponse linéaire. Une même force sur le stylet donne une même pression en sortie. Convient à un usage général."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Risposta lineare. A uguale forza sulla penna corrisponde uguale pressione in uscita. Adatta all’uso generale."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "リニア応答。ペンの力に比例した筆圧を出力します。普段使いに最適です。"
          }
        }
      }
    },
