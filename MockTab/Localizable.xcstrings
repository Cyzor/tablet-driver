      }
    },
    "Delays the stroke release briefly when the pen is lifted mid-motion, preventing accidental short strokes." : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verzögert das Loslassen kurz, wenn der Stift mitten in der Bewegung abgehoben wird – verhindert versehentlich kurze Striche."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Delays the stroke release briefly when the pen is lifted mid-motion, preventing accidental short strokes."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Retrasa brevemente la liberación del trazo cuando se levanta el lápiz en medio del movimiento, evitando trazos cortos accidentales."
