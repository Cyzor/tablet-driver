          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajusta la velocidad a la que el anillo desplaza, amplía, gira o repite pulsaciones de teclas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
