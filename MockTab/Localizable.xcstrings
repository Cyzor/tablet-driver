    },
    "MockTab can't find what this action opens, so the button does nothing." : {
      "comment" : "Tooltip and VoiceOver hint on a button set to open an app, file, or link that's gone or that no app on this Mac opens",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MockTab findet nicht, was diese Aktion öffnet, daher bewirkt die Taste nichts."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MockTab no encuentra lo que abre esta acción, así que el botón no hace nada."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MockTab ne trouve pas ce que cette action ouvre, le bouton ne fait donc rien."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MockTab non trova ciò che questa azione apre, quindi il pulsante non fa nulla."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このアクションで開く対象が見つからないため、ボタンは何もしません。"
          }
        }
      }
    },
    "MockTab can't read some of this yet. The file helps." : {
      "comment" : "Shown during collection when reports arrived that no decoder could read",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MockTab versteht einiges davon noch nicht. Die Datei hilft."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MockTab aún no entiende parte de esto. El archivo ayuda."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MockTab ne sait pas encore tout lire ici. Le fichier aide."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MockTab non riesce ancora a leggere tutto. Il file aiuta."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MockTabがまだ読み取れないデータがあります。このファイルが役立ちます。"
          }
        }
      }
    },
    "MockTab can't read this saved action, so it uses the default." : {
      "comment" : "Tooltip and VoiceOver hint on a button assignment whose saved action MockTab can't read",
      "localizations" : {
        "de" : {
          "stringUnit" : {
