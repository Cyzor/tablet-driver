{
  "sourceLanguage" : "en",
  "strings" : {
    "NSAccessibilityUsageDescription" : {
      "comment" : "Permission prompt: why MockTab needs Accessibility",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MockTab benötigt Zugriff auf die Bedienungshilfen, um die Eingaben deines Grafiktabletts in Cursorbewegungen, Klicks und Tastendrücke umzusetzen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "MockTab needs Accessibility access to turn your tablet's input into cursor movement, clicks, and keystrokes."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MockTab necesita acceso a Accesibilidad para convertir lo que haces con la tableta en movimiento del cursor, clics y pulsaciones de teclas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MockTab a besoin de l’accès à l’Accessibilité pour transformer ce que vous faites sur la tablette en mouvements du curseur, clics et frappes de touches."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MockTab ha bisogno dell’accesso ad Accessibilità per trasformare l’uso della tavoletta in movimenti del cursore, clic e pressioni di tasti."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "タブレットの操作をカーソルの移動、クリック、キー入力に変えるために、MockTab にはアクセシビリティへのアクセスが必要です。"
          }
        }
      }
    },
    "NSBluetoothAlwaysUsageDescription" : {
      "comment" : "Permission prompt: why MockTab uses Bluetooth",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MockTab nutzt Bluetooth, um beim Erfassen von Diagnosedaten die Signalstärke deines Grafiktabletts zu lesen. So lässt sich eine schwache Verbindung von einem Softwareproblem unterscheiden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "MockTab uses Bluetooth to read signal strength from your tablet while collecting diagnostic data, to help tell a weak connection apart from a software problem."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MockTab usa Bluetooth para leer la intensidad de la señal de la tableta mientras recopila datos de diagnóstico, para distinguir una conexión débil de un problema de software."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MockTab utilise le Bluetooth pour lire la puissance du signal de votre tablette pendant la collecte de données de diagnostic, afin de distinguer une connexion faible d’un problème logiciel."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MockTab usa il Bluetooth per leggere l’intensità del segnale della tavoletta durante la raccolta dei dati di diagnostica, così da distinguere una connessione debole da un problema software."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "診断データの収集中にタブレットの信号強度を読み取り、接続の弱さとソフトウェアの問題を見分けるために、MockTab は Bluetooth を使用します。"
          }
        }
      }
    },
    "NSInputMonitoringUsageDescription" : {
      "comment" : "Permission prompt: why MockTab needs Input Monitoring",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MockTab benötigt Zugriff auf die Eingabeüberwachung, um dein Grafiktablett zu lesen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "MockTab needs Input Monitoring access to read your tablet."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MockTab necesita acceso a Monitorización de los dispositivos de entrada para leer la tableta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MockTab a besoin de l’accès à la Surveillance de l’entrée pour lire votre tablette."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MockTab ha bisogno dell’accesso a Monitoraggio input per leggere la tavoletta."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "タブレットを読み取るために、MockTab には入力監視へのアクセスが必要です。"
          }
        }
      }
    }
  },
  "version" : "1.0"
}
